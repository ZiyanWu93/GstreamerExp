# Local machine config — copy hosts.example.yaml and edit.
hosts.yaml

# SCReAM source tree — cloned by setup_remote.sh on first install.
# Not part of this repo (it has its own upstream at
# https://github.com/EricssonResearch/scream).
scream/

# Vendored external repos kept locally for comparison/reference only.
# E.g. the UMN Teleop-Gopher-streamer clone behind
# reference/umn-teleop-gopher-comparison.md. Each has its own upstream.
reference/external/

# Experiment run artifacts. Each `python3 cli.py <id>` writes a new
# directory here (camera.json, viewer.json, summary.json, etc.).
runs/

# User-provided video assets referenced by file-backed video specs.
# See specs/videos/*.yaml `file.path` fields. Sample fixtures may be
# generated by tools/fetch_test_video.sh.
assets/

# Snapshots emitted by analysis/hypotheses/*_emit_snapshot.py — these
# are derived from runs/ and regenerable. Kept out of the repo to
# avoid binary diffs.
analysis/hypotheses/*_data_*.json

# Python build/cache.
__pycache__/
*.pyc

# gstscream plugin staging directory (created by setup_remote.sh).
.scream-plugin/

# gstscream build artifacts (the source tree is gitignored too, but
# this entry survives if someone copies the source in manually).
scream/gstscream/target/

# Intermediate render exports for the UMN comparison. The canonical
# report is h5.html (+ SVGs) and REPORT.md; the combined deck+report PDF
# and the .pptx are committed as the shareable deliverables. These three
# are regenerable scaffolding (standalone PDFs subsumed by the combined
# one; slides.html is the Chrome→PDF mirror of the deck).
analysis/umn-comparison/H5-scream-comparison-report.pdf
analysis/umn-comparison/slides.pdf
analysis/umn-comparison/slides.html
