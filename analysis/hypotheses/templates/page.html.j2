<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ id }} — {{ title }}</title>
<style>
  :root {
    --bg: #ffffff;
    --ink: #1f2328;
    --muted: #5f6b7a;
    --rule: #d9dde5;
    --accent: #2563eb;
    --good-bg: #ecf7ec; --good-fg: #1d6f1d;
    --warn-bg: #fdf3e7; --warn-fg: #a14a02;
    --info-bg: #f0f4fa; --info-fg: #1e3a73;
    --panel-bg: #fafbfc;
    --table-head: #f4f6f9;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
                 Helvetica, Arial, sans-serif;
    max-width: 880px; margin: 32px auto; padding: 0 18px 60px;
    color: var(--ink); line-height: 1.55; background: var(--bg);
  }
  h1 { font-size: 22px; margin: 0 0 4px 0; }
  h2 { font-size: 17px; margin: 28px 0 8px 0;
       border-bottom: 1px solid var(--rule); padding-bottom: 4px; }
  p { margin: 8px 0; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .nav { font-size: 13px; margin-bottom: 14px; }
  .tag { display: inline-block; font-size: 12px; padding: 2px 8px;
         border-radius: 10px; background: var(--info-bg);
         color: var(--info-fg); margin-right: 6px; }
  .tag.supported    { background: var(--good-bg); color: var(--good-fg); }
  .tag.refuted      { background: var(--warn-bg); color: var(--warn-fg); }
  .tag.regime-dependent { background: var(--warn-bg); color: var(--warn-fg); }
  .panel { background: var(--panel-bg); border: 1px solid var(--rule);
           border-radius: 6px; padding: 12px 16px; margin: 14px 0; }
  .panel strong.label { display: block; font-size: 12px;
                        text-transform: uppercase; letter-spacing: 0.5px;
                        color: var(--muted); margin-bottom: 4px; }
  ul { padding-left: 22px; margin: 8px 0; }
  ul li { margin-bottom: 4px; }
  figure { margin: 14px 0; }
  figure img { max-width: 100%; height: auto;
               border: 1px solid var(--rule); border-radius: 4px;
               background: white; padding: 6px; }
  figure figcaption { font-size: 13px; color: var(--muted);
                      margin-top: 6px; }
  table { border-collapse: collapse; width: 100%; font-size: 13px;
          margin: 10px 0 18px 0; }
  th, td { border: 1px solid var(--rule); padding: 4px 8px;
           text-align: left; vertical-align: top; }
  th { background: var(--table-head); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  pre, code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
              font-size: 13px; }
  pre { background: var(--panel-bg); border: 1px solid var(--rule);
        padding: 8px 10px; border-radius: 4px; overflow-x: auto; }
  .meta { font-size: 13px; color: var(--muted); }
  .source { font-size: 13px; color: var(--muted); margin-top: 4px; }
  .footer { font-size: 12px; color: var(--muted); margin-top: 36px;
            border-top: 1px solid var(--rule); padding-top: 10px; }
</style>
</head>
<body>

<p class="nav"><a href="../../index.html">← GstreamerExp hub</a> · <a href="../../README.md">README</a> · <a href="../../docs/HYPOTHESES.md">Hypothesis catalog</a></p>

<h1>{{ id }} — {{ title }}</h1>
<p><span class="tag {{ status }}">{{ status }}</span><span class="meta">{{ source }}</span></p>

<h2>Claim</h2>
<p>{{ claim }}</p>

<h2>Prediction</h2>
<p>{{ prediction }}</p>

<h2>Verdict rule</h2>
<p>{{ verdict_rule }}</p>

{% if mechanism %}
<h2>Main claim</h2>
<div class="panel">
<strong class="label">Mechanism</strong>
<p>{{ mechanism }}</p>
</div>
{% endif %}

{% if supporting_subclaims %}
<h2>Supporting evidence</h2>
<ul>
{% for item in supporting_subclaims %}<li>{{ item }}</li>
{% endfor %}</ul>
{% endif %}

{% if trace_characteristics %}
<h2>Trace Characteristics</h2>
<ul>
{% for entry in trace_characteristics %}<li>{{ entry.sentence }}</li>
{% endfor %}</ul>
{% endif %}

{% if established_claims or limits %}
<h2>Findings and Limitations</h2>
{% if established_claims %}
<p class="meta"><strong>Findings</strong></p>
<ul>
{% for item in established_claims %}<li>{{ item }}</li>
{% endfor %}</ul>
{% endif %}
{% if limits %}
<p class="meta"><strong>Limitations</strong></p>
<ul>
{% for item in limits %}<li>{{ item }}</li>
{% endfor %}</ul>
{% endif %}
{% endif %}

{% if figures %}
<h2>Figures</h2>
{% for fig in figures %}<figure>
  <img src="{{ fig.src }}" alt="{{ fig.caption }}">
  <figcaption>{{ fig.caption }}</figcaption>
</figure>
{% endfor %}{% endif %}

{% if tables %}
<h2>Tables</h2>
{% for tbl in tables %}<h3 style="font-size:14px;margin:14px 0 4px 0;">{{ tbl.title }}</h3>
<table>
<thead><tr>{% for col in tbl.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
<tbody>
{% for row in tbl.rows %}<tr>{% for cell in row %}<td{% if cell.numeric %} class="num"{% endif %}>{{ cell.value }}</td>{% endfor %}</tr>
{% endfor %}</tbody>
</table>
{% endfor %}{% endif %}

<h2>Experimental setup</h2>
{% for exp in experiments %}<div class="panel">
<strong class="label">{{ exp.name }}</strong>
{% if exp.description %}<p>{{ exp.description }}</p>{% endif %}
<p class="meta">Configurations: {% for arm in exp.arms %}<code>{{ arm.config_id }}</code> ({{ arm.algorithm }}){% if not loop.last %}, {% endif %}{% endfor %}{% if exp.reps %} · reps: {{ exp.reps }}{% endif %}</p>
<p class="meta">Spec: <code>{{ exp.spec_path }}</code> · Record: <code>{{ exp.record_path }}</code> · Run: <code>{{ exp.command }}</code></p>
{% if exp.record_status %}<p class="meta">Status: {{ exp.record_status.completed_runs }} of {{ exp.record_status.total_runs }} runs completed.</p>{% endif %}
</div>
{% endfor %}

<h2>Required metrics</h2>
<ul>
{% for metric in required_metrics %}<li><code>{{ metric }}</code></li>
{% endfor %}</ul>

<h2>Reproducibility</h2>
<p>This page is generated from <code>specs/hypotheses/{{ slug }}.yaml</code> + <code>analysis/hypotheses/results/{{ slug }}_report.json</code> + figures under <code>analysis/hypotheses/results/</code>.</p>
<pre>python3 analysis/hypotheses/build_reports.py
python3 analysis/hypotheses/build_pages.py
python3 {{ verifier }}</pre>

<p class="source">Source: {{ source }}</p>

<p class="footer">Generated by <code>analysis/hypotheses/build_pages.py</code>. Do not hand-edit; modify <code>specs/hypotheses/{{ slug }}.yaml</code> or the template instead.</p>

</body>
</html>
